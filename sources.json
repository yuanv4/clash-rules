{
  "release_base_url": "https://raw.githubusercontent.com/yuanv4/clash-rules/release",
  "proxy_group": "🚀 节点选择",
  "inputs": [
    {
      "name": "boweic/ruleset.bowei.co",
      "repository": "https://github.com/boweic/ruleset.bowei.co",
      "base_url": "https://raw.githubusercontent.com/boweic/ruleset.bowei.co/master/",
      "license": {
        "id": "AGPL-3.0",
        "url": "https://github.com/boweic/ruleset.bowei.co/blob/master/LICENSE"
      },
      "input_format": "raw-list"
    },
    {
      "name": "blackmatrix7/ios_rule_script",
      "repository": "https://github.com/blackmatrix7/ios_rule_script",
      "base_url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/",
      "license": {
        "id": "GPL-2.0",
        "url": "https://github.com/blackmatrix7/ios_rule_script/blob/master/LICENSE"
      },
      "input_format": "raw-list"
    },
    {
      "name": "Loyalsoldier/clash-rules",
      "repository": "https://github.com/Loyalsoldier/clash-rules",
      "base_url": "https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/",
      "license": {
        "id": "MIT",
        "url": "https://github.com/Loyalsoldier/clash-rules/blob/release/LICENSE"
      },
      "input_format": "clash-yaml"
    },
    {
      "name": "VPSDance/ai-proxy-rules",
      "repository": "https://github.com/VPSDance/ai-proxy-rules",
      "base_url": "https://raw.githubusercontent.com/VPSDance/ai-proxy-rules/main/",
      "license": {
        "id": "MIT",
        "url": "https://github.com/VPSDance/ai-proxy-rules/blob/main/LICENSE"
      },
      "input_format": "clash-yaml"
    },
    {
      "name": "custom/tag",
      "repository": "https://github.com/yuanv4/clash-rules",
      "base_url": "https://raw.githubusercontent.com/yuanv4/clash-rules/main/",
      "license": {
        "id": "MIT",
        "url": "https://github.com/yuanv4/clash-rules"
      },
      "input_format": "raw-list"
    }
  ],
  "providers": [
    {
      "name": "lan_non_ip",
      "target": "DIRECT",
      "no_resolve": true,
      "inputs": [{"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/lan.txt"}]
    },
    {
      "name": "lan_ip",
      "target": "DIRECT",
      "no_resolve": true,
      "inputs": [{"input": "boweic/ruleset.bowei.co", "path": "Clash/ip/lan.txt"}]
    },
    {
      "name": "reject_non_ip",
      "target": "REJECT",
      "no_resolve": true,
      "inputs": [{"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/reject.txt"}]
    },
    {
      "name": "reject_ip",
      "target": "REJECT",
      "no_resolve": true,
      "inputs": [{"input": "boweic/ruleset.bowei.co", "path": "Clash/ip/reject.txt"}]
    },
    {
      "name": "ai",
      "target": "🤖 AI",
      "no_resolve": true,
      "inputs": [
        {"input": "VPSDance/ai-proxy-rules", "path": "rules/clash/global.yaml"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/apple_intelligence.txt"}
      ]
    },
    {
      "name": "direct",
      "target": "🌐 国内",
      "no_resolve": true,
      "inputs": [
        {"input": "Loyalsoldier/clash-rules", "path": "direct.txt"},
        {"input": "Loyalsoldier/clash-rules", "path": "cncidr.txt"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/direct.txt"}
      ]
    },
    {
      "name": "tag",
      "target": "🌐 国内",
      "no_resolve": true,
      "inputs": [
        {"input": "custom/tag", "path": "custom/tag.txt"}
      ]
    },
    {
      "name": "foreign",
      "target": "⚡ 自动选择",
      "no_resolve": false,
      "inputs": [
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/stream.txt"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/ip/stream.txt"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/microsoft_cdn.txt"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/microsoft.txt"},
        {"input": "blackmatrix7/ios_rule_script", "path": "rule/Clash/Apple/Apple.list"},
        {"input": "blackmatrix7/ios_rule_script", "path": "rule/Clash/Google/Google.list"},
        {"input": "blackmatrix7/ios_rule_script", "path": "rule/Clash/Telegram/Telegram.list"},
        {"input": "blackmatrix7/ios_rule_script", "path": "rule/Clash/Twitter/Twitter.list"},
        {"input": "blackmatrix7/ios_rule_script", "path": "rule/Clash/Facebook/Facebook.list"},
        {"input": "blackmatrix7/ios_rule_script", "path": "rule/Clash/Instagram/Instagram.list"},
        {"input": "Loyalsoldier/clash-rules", "path": "tld-not-cn.txt"}
      ]
    }
  ]
}
