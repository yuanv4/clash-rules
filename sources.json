      "target": "DIRECT",
      "no_resolve": true,
      "inputs": [{"input": "boweic/ruleset.bowei.co", "path": "Clash/ip/domestic.txt"}]
    },
    {
      "name": "direct_non_ip",
      "target": "DIRECT",
      "no_resolve": true,
      "inputs": [{"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/direct.txt"}]
    },
    {
