{
  "release_base_url": "https://raw.githubusercontent.com/yuanv4/clash-rules/release",
  "proxy_group": "♻️ 自动选择(香港)",
  "inputs": [
    {
      "name": "boweic/ruleset.bowei.co",
      "repository": "https://github.com/boweic/ruleset.bowei.co",
      "base_url": "https://raw.githubusercontent.com/boweic/ruleset.bowei.co/master/",
      "license": {
        "id": "AGPL-3.0",
        "url": "https://github.com/boweic/ruleset.bowei.co/blob/master/LICENSE"
      },
      "input_format": "raw-list"
    },
    {
      "name": "VPSDance/ai-proxy-rules",
      "repository": "https://github.com/VPSDance/ai-proxy-rules",
      "base_url": "https://raw.githubusercontent.com/VPSDance/ai-proxy-rules/main/",
      "license": {
        "id": "MIT",
        "url": "https://github.com/VPSDance/ai-proxy-rules/blob/main/LICENSE"
      },
      "input_format": "clash-yaml"
    },
    {
      "name": "MetaCubeX/meta-rules-dat",
      "repository": "https://github.com/MetaCubeX/meta-rules-dat",
      "base_url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/",
      "license": {
        "id": "GPL-3.0",
        "url": "https://github.com/MetaCubeX/meta-rules-dat/blob/master/LICENSE"
      },
      "input_format": "clash-yaml"
    },
    {
      "name": "custom/tag",
      "repository": "https://github.com/yuanv4/clash-rules",
      "base_url": "https://raw.githubusercontent.com/yuanv4/clash-rules/main/",
      "license": {
        "id": "MIT",
        "url": "https://github.com/yuanv4/clash-rules"
      },
      "input_format": "raw-list"
    },
    {
      "name": "TG-Twilight/AWAvenue-Ads-Rule",
      "repository": "https://github.com/TG-Twilight/AWAvenue-Ads-Rule",
      "base_url": "https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/",
      "license": {
        "id": "GPL-3.0",
        "url": "https://github.com/TG-Twilight/AWAvenue-Ads-Rule/blob/main/LICENSE"
      },
      "input_format": "clash-yaml"
    }
  ],
  "providers": [
    {
      "name": "direct",
      "target": "DIRECT",
      "no_resolve": true,
      "inputs": [
        {"input": "custom/tag", "path": "custom/tag.txt"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/lan.txt"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/ip/lan.txt"}
      ]
    },
    {
      "name": "reject_domainset",
      "target": "🛑 广告过滤",
      "behavior": "domain",
      "no_resolve": true,
      "inputs": [{"input": "boweic/ruleset.bowei.co", "path": "Clash/domainset/reject.txt", "input_format": "domain-text"}]
    },
    {
      "name": "reject",
      "target": "🛑 广告过滤",
      "no_resolve": true,
      "inputs": [
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/reject.txt"},
        {"input": "TG-Twilight/AWAvenue-Ads-Rule", "path": "Filters/AWAvenue-Ads-Rule-Clash-Classical-Only.Ads.yaml"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/ip/reject.txt"}
      ]
    },
    {
      "name": "ai",
      "target": "🤖 国际 AI",
      "no_resolve": true,
      "inputs": [
        {"input": "VPSDance/ai-proxy-rules", "path": "rules/clash/global.yaml"},
        {"input": "boweic/ruleset.bowei.co", "path": "Clash/non_ip/apple_intelligence.txt"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/category-ai-!cn.yaml"}
      ]
    },
    {
      "name": "cn_services",
      "target": "🇨🇳 国内服务",
      "no_resolve": true,
      "inputs": [
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/apple-cn.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/microsoft@cn.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/steam@cn.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/category-games@cn.yaml"}
      ]
    },
    {
      "name": "dev_services",
      "target": "🧑‍💻 开发服务",
      "no_resolve": true,
      "inputs": [
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/category-dev.yaml"}
      ]
    },
    {
      "name": "streaming_services",
      "target": "🎬 流媒体服务",
      "no_resolve": true,
      "inputs": [
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/netflix.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geoip/netflix.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/disney.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/category-media.yaml"}
      ]
    },
    {
      "name": "foreign_services",
      "target": "🌐 国外服务",
      "no_resolve": true,
      "inputs": [
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/google.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geoip/google.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/telegram.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geoip/telegram.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/steam.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/microsoft.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/apple.yaml"},
        {"input": "MetaCubeX/meta-rules-dat", "path": "geo/geosite/geolocation-!cn.yaml"}
      ]
    }
  ]
}
